<<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="FCLSystem.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Fort Hare Courier & Logistics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark text-light">
    <form runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
            <div class="container">
                <a class="navbar-brand text-warning fw-bold" runat="server" href="~/">
                    <span class="bg-warning text-dark p-1 rounded me-2">FCL</span>Fort Hare Courier
                </a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Tracking">Tracking</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pricing">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact">Contact</a></li>
                    </ul>
                    <div class="d-flex">
                        <a runat="server" href="~/Login.aspx" class="btn btn-outline-light me-2">Sign In</a>
                        <a runat="server" href="~/Register.aspx" class="btn btn-warning text-dark fw-bold">Register</a>
                    </div>
                </div>
            </div>
        </nav>
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>